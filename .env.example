# Copy to .env.local and adjust. No cloud credentials are needed any more.

# Where the SQLite file and uploaded images live.
# Point this at a mounted USB SSD on the Pi — SD cards wear out under database writes.
DATA_DIR=/srv/prop-catalog/data

# Only addresses at this domain may register. Enforced server-side in /api/auth/signup.
ALLOWED_EMAIL_DOMAIN=robcol.k12.tr

# Set to true ONLY when the app is served over HTTPS (e.g. behind Caddy or nginx).
# A Secure cookie is silently dropped over plain http://, which would break login entirely.
COOKIE_SECURE=false

# Port the Next server listens on.
PORT=3000
