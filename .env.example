# Copy to .env.local and adjust. No cloud credentials are needed any more.

# Where the SQLite file and uploaded images live. Defaults to ./data, which is right for local
# work. On the Pi, point this at a mounted USB SSD — SD cards wear out under database writes.
# DATA_DIR=/mnt/ssd/prop-catalog

# Only addresses at this domain may register. Enforced server-side in /api/auth/signup.
ALLOWED_EMAIL_DOMAIN=robcol.k12.tr

# Set to true ONLY when the app is served over HTTPS (e.g. behind Caddy or nginx).
# A Secure cookie is silently dropped over plain http://, which would break login entirely.
COOKIE_SECURE=false

# Port the Next server listens on.
PORT=3000

# Extra confirmation code required to change a user's role in the admin Users tab.
# Verified server-side. If unset, role changes are refused rather than allowed.
# Leave BLANK here — this file is committed. Put a long random secret in .env.local only.
ADMIN_PROMOTE_CODE=

# Set to true when a trusted reverse proxy (Caddy/nginx) sits in front and sets
# X-Forwarded-For — which is how the README deploys it. Without it every visitor shares one
# rate-limit bucket. If the app is reachable directly, leave it false: the forwarded header
# is attacker-controlled and would let anyone bypass the login/signup rate limits.
TRUST_PROXY=false

# --- Email confirmation (required for sign-up) ---
# Public URL used to build the confirmation link that goes in the email.
APP_URL=http://localhost:3000
# 'console' prints the link to the server log instead of sending — for development only.
# Production refuses it, and refuses sign-up if SMTP is not configured, rather than creating
# accounts nobody can confirm. Delete this line (or set 'smtp') on the Pi.
MAIL_TRANSPORT=console
# SMTP relay — the school's mail server, or Gmail with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Prop Catalog <no-reply@robcol.k12.tr>"
