# Copy to .env.local and adjust.

# Database and uploads. Defaults to ./data; on the Pi use an SSD.
# DATA_DIR=/mnt/ssd/prop-catalog

# Only this email domain may sign up.
ALLOWED_EMAIL_DOMAIN=robcol.k12.tr

# true only behind HTTPS; over plain http it breaks login.
COOKIE_SECURE=false

PORT=3000

# Code required to change roles; unset disables role changes.
# Leave blank here (this file is committed); set it in .env.local.
ADMIN_PROMOTE_CODE=

# true behind Caddy/nginx. Keep false if the app is reachable directly: the header can be forged.
TRUST_PROXY=false

# --- Email (required for sign-up) ---
# Public URL used in emailed links.
APP_URL=http://localhost:3000
# 'console' logs links instead of sending (dev only; refused in production). Delete on the Pi.
MAIL_TRANSPORT=console
# SMTP: the school's server, or Gmail with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Prop Catalog <no-reply@robcol.k12.tr>"
