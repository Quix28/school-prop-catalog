# systemd unit: /etc/systemd/system/prop-catalog.service
# sudo systemctl daemon-reload && sudo systemctl enable --now prop-catalog

[Unit]
Description=School Prop & Costume Catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change to the account that owns /srv/prop-catalog and ran npm run build.
User=pi
WorkingDirectory=/srv/prop-catalog
EnvironmentFile=/srv/prop-catalog/.env.local
# Reservation dates use the server's local day.
Environment=TZ=Europe/Istanbul
# Listen on localhost only, so the reverse proxy is the only way in.
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

# Only DATA_DIR needs to be writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# '-' skips a missing path instead of failing the unit. Add DATA_DIR if it's elsewhere.
ReadWritePaths=-/srv/prop-catalog/data

[Install]
WantedBy=multi-user.target
