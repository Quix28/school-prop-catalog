# systemd unit: /etc/systemd/system/prop-catalog.service
# sudo systemctl daemon-reload && sudo systemctl enable --now prop-catalog

[Unit]
Description=School Prop & Costume Catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/srv/prop-catalog
EnvironmentFile=/srv/prop-catalog/.env.local
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# The service only ever needs to write inside DATA_DIR.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/prop-catalog/data

[Install]
WantedBy=multi-user.target
