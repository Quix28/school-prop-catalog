# systemd unit: /etc/systemd/system/prop-catalog.service
# sudo systemctl daemon-reload && sudo systemctl enable --now prop-catalog

[Unit]
Description=School Prop & Costume Catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Recent Raspberry Pi OS images have no 'pi' user unless you named it so in the imager —
# use the account that owns /srv/prop-catalog (check with: ls -ld /srv/prop-catalog).
User=pi
WorkingDirectory=/srv/prop-catalog
EnvironmentFile=/srv/prop-catalog/.env.local
# Reservation dates are compared with the server's "today", so it must be the school's day.
Environment=TZ=Europe/Istanbul
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# The service only ever needs to write inside DATA_DIR.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Leading '-': a missing path is skipped instead of failing the unit with 226/NAMESPACE (e.g.
# when DATA_DIR lives on the SSD instead). Add your DATA_DIR here if it is somewhere else.
ReadWritePaths=-/srv/prop-catalog/data

[Install]
WantedBy=multi-user.target
